# Copy this file to .env and fill in the values (DO NOT commit secrets to git)
# Example environment variables used by the app
MONGO_URI=mongodb://localhost:27017/kodr_db
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_SECRET=replace_with_a_secure_random_value
REFRESH_SECRET=replace_with_a_secure_random_value
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Add your GROQ API key here
GROQ_API_KEY=your_groq_api_key_here
